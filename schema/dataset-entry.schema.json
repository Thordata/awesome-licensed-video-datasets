{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Thordata/awesome-licensed-video-datasets/blob/main/schema/dataset-entry.schema.json",
  "title": "Licensed video dataset catalog entry",
  "type": "object",
  "required": [
    "name",
    "provider",
    "category",
    "homepage",
    "data_access_url",
    "license_name",
    "license_url",
    "access_type",
    "permissions",
    "license_status",
    "last_verified",
    "evidence"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "format": "uri" },
    "repository": { "type": "string", "format": "uri" },
    "data_access_url": { "type": "string", "format": "uri" },
    "sample_media_url": { "type": "string", "format": "uri" },
    "license_name": { "type": "string", "minLength": 1 },
    "license_url": { "type": "string", "format": "uri" },
    "access_type": {
      "type": "string",
      "enum": ["public", "public-preview", "research-only", "application", "purchase", "gated", "unknown"]
    },
    "download_requires_login": {
      "type": "string",
      "enum": ["yes", "no", "conditional", "unknown"]
    },
    "purchase_required": {
      "type": "string",
      "enum": ["yes", "no", "conditional", "unknown"]
    },
    "permissions": {
      "type": "object",
      "required": ["download", "research", "training", "fine_tuning", "commercial", "frame_extraction", "redistribution"],
      "properties": {
        "download": { "$ref": "#/$defs/permission" },
        "research": { "$ref": "#/$defs/permission" },
        "training": { "$ref": "#/$defs/permission" },
        "fine_tuning": { "$ref": "#/$defs/permission" },
        "commercial": { "$ref": "#/$defs/permission" },
        "frame_extraction": { "$ref": "#/$defs/permission" },
        "redistribution": { "$ref": "#/$defs/permission" }
      },
      "additionalProperties": false
    },
    "scale": { "type": "string" },
    "annotations": { "type": "string" },
    "privacy_review": { "type": "string" },
    "license_status": {
      "type": "string",
      "enum": ["verified", "pending-confirmation", "not-verified"]
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uri" }
    }
  },
  "$defs": {
    "permission": {
      "type": "string",
      "enum": ["allowed", "not-allowed", "conditional", "pending", "unknown"]
    }
  },
  "additionalProperties": false
}
